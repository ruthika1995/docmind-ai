# ==========================================
# DocMind AI — Environment Configuration
# ==========================================

# OpenRouter Gateway Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Alternative tested OpenRouter models:
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL=mistralai/mistral-small-24b-instruct-2501:free

# Database Configuration (PostgreSQL with pgvector, or local SQLite for development)
DATABASE_URL=sqlite:///./docmind.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# JWT Secret for Authenticated Workspaces
JWT_SECRET=supersecret-docmind-jwt-key-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
